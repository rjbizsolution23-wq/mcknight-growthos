{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rj-funnel-command-center",
  "compatibility_date": "2026-07-10",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // ── v3.3: Cloudflare D1 — permanent lead storage + short funnel links ──
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rj-funnel-leads",
      "database_id": "c624734c-5fad-4f6e-a561-4b52163f1a04"
    }
  ],
  // ── v3.3: Workers AI — LLM copy generation + lead insights (no API key needed) ──
  "ai": {
    "binding": "AI"
  }
}
